# Hatamoto Core — example environment
#
# Copy to `.env` (`cp .env.example .env`). The values below mirror the
# defaults baked into docker-compose.yml, so `docker compose up` works with
# NO .env at all — this file exists for documentation and for overriding the
# demo defaults. `.env` is gitignored; never commit real secrets.
#
# See README.md ("Production hardening") before exposing any of this to the
# internet — the compose defaults are a local/demo topology only.

# ---------------------------------------------------------------------------
# hatamoto (backend/cmd/hatamoto)
# ---------------------------------------------------------------------------
# `development` (default) or `production`. `production` enables HSTS — only enable behind HTTPS.
ENVIRONMENT=development

# Secure flag for the admin session cookie and for cookies set by plugins.
# Defaults to true when ENVIRONMENT=production, false otherwise. This replaces
# LEAD_COOKIE_SECURE, which is no longer read: a non-production deploy that set
# only LEAD_COOKIE_SECURE=true must now set this too, or plugin cookies go out
# without the Secure flag.
# ADMIN_COOKIE_SECURE=

# Postgres connection. Matches the compose `db` service defaults.
DATABASE_URL=postgres://hatamoto:hatamoto@db:5432/hatamoto?sslmode=disable

API_HOST=0.0.0.0
API_PORT=8090
# How long rendered public pages stay in the HTML cache (Go duration, 30s..24h, default 5m).
# Content, menu, settings, theme and plugin changes clear it at once; data a plugin
# renders into a page is cached for this long. Purges are per process: with several
# replicas, or CLI writes against a running server, keep the TTL short.
# Needs PUBLIC_BASE_URL.
# HATAMOTO_PAGE_CACHE_TTL=5m
# Extra browser origins allowed to call /mcp (the public origin is always allowed; clients without an Origin header are unaffected)
# HATAMOTO_MCP_ALLOWED_ORIGINS=

HATAMOTO_SITE_NAME=Hatamoto CMS
HATAMOTO_CANONICAL_SLUG=hatamoto

# Server secret (keys the flash cookie, theme previews and stored import
# credentials). LEAVE BLANK for local/demo: `hatamoto serve` generates and
# persists one on first boot (in HATAMOTO_SECRETS_DIR, default ./data/secrets).
# In production, supply your own (>=32 chars) via your secret manager instead;
# a value in the environment always wins. JWT_SECRET is the old name of the same
# setting and keeps working; HATAMOTO_SECRET wins if both are set.
HATAMOTO_SECRET=

# Email. The compose defaults (SMTP_HOST=localhost) leave email disabled.
# Provide real credentials for production.
SMTP_HOST=localhost
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Hatamoto
SMTP_USERNAME=
SMTP_PASSWORD=

# Security headers. CSP_ENFORCE=true switches from Report-Only to enforcing —
# only after verifying no violations.
CSP_ENFORCE=false
SECURITY_HEADERS_DISABLED=false

# Extra section types (comma-separated) whose content.body is html and must be
# sanitised on save like type `html`; for plugins that alias legacy types to
# html on the frontend. Also honoured by `sanitize-html-sections`. Default empty.
HTML_SECTION_TYPE_ALIASES=

# Hosts whose iframes survive the sanitiser (rich text and html sections),
# comma-separated host names (no scheme or port). Unset: YouTube
# (youtube.com, youtube-nocookie.com, /embed/ only) and Vimeo (player.vimeo.com,
# /video/ only). A list replaces that default (keep the video hosts in it if
# editors embed videos: the editor and the WP importer produce only those); any other host may be embedded
# at any https path. Also read by the embedAllowed template func.
HATAMOTO_EMBED_HOSTS=

# First admin: open /admin and enter the setup code from the logs, or run
#   docker compose exec hatamoto hatamoto user create --email you@example.com
