blur	base=4px md=0 sm=20px
blur	.hm-n-g{filter:blur(4px);}@media (max-width:1024px){.hm-n-g{filter:blur(0);}}@media (max-width:640px){.hm-n-g{filter:blur(20px);}}
blur+preset	.hm-n-g.hm-n-g{filter:blur(4px);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:blur(0);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:blur(20px);}}
bright	base=120% md=0% sm=200%
bright	.hm-n-g{filter:brightness(120%);}@media (max-width:1024px){.hm-n-g{filter:brightness(0%);}}@media (max-width:640px){.hm-n-g{filter:brightness(200%);}}
bright+preset	.hm-n-g.hm-n-g{filter:brightness(120%);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:brightness(0%);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:brightness(200%);}}
contrast	base=150% md=100% sm=0%
contrast	.hm-n-g{filter:contrast(150%);}@media (max-width:1024px){.hm-n-g{filter:contrast(100%);}}@media (max-width:640px){.hm-n-g{filter:contrast(0%);}}
contrast+preset	.hm-n-g.hm-n-g{filter:contrast(150%);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:contrast(100%);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:contrast(0%);}}
sat	base=80% md=200% sm=0%
sat	.hm-n-g{filter:saturate(80%);}@media (max-width:1024px){.hm-n-g{filter:saturate(200%);}}@media (max-width:640px){.hm-n-g{filter:saturate(0%);}}
sat+preset	.hm-n-g.hm-n-g{filter:saturate(80%);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:saturate(200%);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:saturate(0%);}}
gray	base=100% md=0% sm=50%
gray	.hm-n-g{filter:grayscale(100%);}@media (max-width:1024px){.hm-n-g{filter:grayscale(0%);}}@media (max-width:640px){.hm-n-g{filter:grayscale(50%);}}
gray+preset	.hm-n-g.hm-n-g{filter:grayscale(100%);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:grayscale(0%);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:grayscale(50%);}}
hue	base=90deg md=0deg sm=360deg
hue	.hm-n-g{filter:hue-rotate(90deg);}@media (max-width:1024px){.hm-n-g{filter:hue-rotate(0deg);}}@media (max-width:640px){.hm-n-g{filter:hue-rotate(360deg);}}
hue+preset	.hm-n-g.hm-n-g{filter:hue-rotate(90deg);}@media (max-width:1024px){.hm-n-g.hm-n-g{filter:hue-rotate(0deg);}}@media (max-width:640px){.hm-n-g.hm-n-g{filter:hue-rotate(360deg);}}
bblur	base=8px md=40px sm=0
bblur	.hm-n-g{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);}@media (max-width:1024px){.hm-n-g{backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);}}@media (max-width:640px){.hm-n-g{backdrop-filter:blur(0);-webkit-backdrop-filter:blur(0);}}
bblur+preset	.hm-n-g.hm-n-g{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);}@media (max-width:1024px){.hm-n-g.hm-n-g{backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);}}@media (max-width:640px){.hm-n-g.hm-n-g{backdrop-filter:blur(0);-webkit-backdrop-filter:blur(0);}}
blend	base=multiply md=normal sm=screen
blend	.hm-n-g{mix-blend-mode:multiply;}@media (max-width:1024px){.hm-n-g{mix-blend-mode:normal;}}@media (max-width:640px){.hm-n-g{mix-blend-mode:screen;}}
blend+preset	.hm-n-g.hm-n-g{mix-blend-mode:multiply;}@media (max-width:1024px){.hm-n-g.hm-n-g{mix-blend-mode:normal;}}@media (max-width:640px){.hm-n-g.hm-n-g{mix-blend-mode:screen;}}
