cgap	base=space-3 md=2rem sm=0
cgap	.hm-n-g{column-gap:var(--hm-space-3,0.75rem);}@media (max-width:1024px){.hm-n-g{column-gap:2rem;}}@media (max-width:640px){.hm-n-g{column-gap:0;}}
cgap+preset	.hm-n-g.hm-n-g{column-gap:var(--hm-space-3,0.75rem);}@media (max-width:1024px){.hm-n-g.hm-n-g{column-gap:2rem;}}@media (max-width:640px){.hm-n-g.hm-n-g{column-gap:0;}}
gtc	base=1fr 2fr md=auto 1fr sm=1fr
gtc	.hm-n-g{grid-template-columns:minmax(0,1fr) minmax(0,2fr);}@media (max-width:1024px){.hm-n-g{grid-template-columns:auto minmax(0,1fr);}}@media (max-width:640px){.hm-n-g{grid-template-columns:minmax(0,1fr);}}
