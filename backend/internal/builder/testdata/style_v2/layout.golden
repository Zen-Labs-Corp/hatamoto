rgap	base=space-2 md=1rem sm=0
rgap	.hm-n-g{row-gap:var(--hm-space-2,0.5rem);}@media (max-width:1024px){.hm-n-g{row-gap:1rem;}}@media (max-width:640px){.hm-n-g{row-gap:0;}}
