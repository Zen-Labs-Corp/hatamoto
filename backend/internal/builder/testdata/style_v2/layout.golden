display	base=flex md=block sm=none
display	.hm-n-g{display:flex;}@media (max-width:1024px){.hm-n-g{display:block;}}@media (max-width:640px){.hm-n-g{display:none;}}
display+preset	.hm-n-g.hm-n-g{display:flex;}@media (max-width:1024px){.hm-n-g.hm-n-g{display:block;}}@media (max-width:640px){.hm-n-g.hm-n-g{display:none;}}
order	base=-1 md=0 sm=12
order	.hm-n-g{order:-1;}@media (max-width:1024px){.hm-n-g{order:0;}}@media (max-width:640px){.hm-n-g{order:12;}}
