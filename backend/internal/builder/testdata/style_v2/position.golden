pos	base=sticky md=relative sm=absolute
pos	.hm-n-g{position:sticky;}@media (max-width:1024px){.hm-n-g{position:relative;}}@media (max-width:640px){.hm-n-g{position:absolute;}}
pos+preset	.hm-n-g.hm-n-g{position:sticky;}@media (max-width:1024px){.hm-n-g.hm-n-g{position:relative;}}@media (max-width:640px){.hm-n-g.hm-n-g{position:absolute;}}
top	base=0 md=-1rem sm=space-4
top	.hm-n-g{top:0;}@media (max-width:1024px){.hm-n-g{top:-1rem;}}@media (max-width:640px){.hm-n-g{top:var(--hm-space-4,1rem);}}
top+preset	.hm-n-g.hm-n-g{top:0;}@media (max-width:1024px){.hm-n-g.hm-n-g{top:-1rem;}}@media (max-width:640px){.hm-n-g.hm-n-g{top:var(--hm-space-4,1rem);}}
right	base=0 md=1rem sm=auto
right	.hm-n-g{right:0;}@media (max-width:1024px){.hm-n-g{right:1rem;}}@media (max-width:640px){.hm-n-g{right:auto;}}
right+preset	.hm-n-g.hm-n-g{right:0;}@media (max-width:1024px){.hm-n-g.hm-n-g{right:1rem;}}@media (max-width:640px){.hm-n-g.hm-n-g{right:auto;}}
bottom	base=-10px md=space-1 sm=0
bottom	.hm-n-g{bottom:-10px;}@media (max-width:1024px){.hm-n-g{bottom:var(--hm-space-1,0.25rem);}}@media (max-width:640px){.hm-n-g{bottom:0;}}
bottom+preset	.hm-n-g.hm-n-g{bottom:-10px;}@media (max-width:1024px){.hm-n-g.hm-n-g{bottom:var(--hm-space-1,0.25rem);}}@media (max-width:640px){.hm-n-g.hm-n-g{bottom:0;}}
left	base=50% md=auto sm=-5%
left	.hm-n-g{left:50%;}@media (max-width:1024px){.hm-n-g{left:auto;}}@media (max-width:640px){.hm-n-g{left:-5%;}}
left+preset	.hm-n-g.hm-n-g{left:50%;}@media (max-width:1024px){.hm-n-g.hm-n-g{left:auto;}}@media (max-width:640px){.hm-n-g.hm-n-g{left:-5%;}}
z	base=0 md=10 sm=100
z	.hm-n-g{z-index:0;}@media (max-width:1024px){.hm-n-g{z-index:10;}}@media (max-width:640px){.hm-n-g{z-index:100;}}
z+preset	.hm-n-g.hm-n-g{z-index:0;}@media (max-width:1024px){.hm-n-g.hm-n-g{z-index:10;}}@media (max-width:640px){.hm-n-g.hm-n-g{z-index:100;}}
scrollmt	base=5rem md=0 sm=80px
scrollmt	.hm-n-g{scroll-margin-top:5rem;}@media (max-width:1024px){.hm-n-g{scroll-margin-top:0;}}@media (max-width:640px){.hm-n-g{scroll-margin-top:80px;}}
scrollmt+preset	.hm-n-g.hm-n-g{scroll-margin-top:5rem;}@media (max-width:1024px){.hm-n-g.hm-n-g{scroll-margin-top:0;}}@media (max-width:640px){.hm-n-g.hm-n-g{scroll-margin-top:80px;}}
