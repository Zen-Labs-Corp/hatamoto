ff	base=body md=heading sm=mono
ff	.hm-n-g{font-family:var(--hm-font,inherit);}@media (max-width:1024px){.hm-n-g{font-family:var(--hm-font-heading,var(--hm-font,inherit));}}@media (max-width:640px){.hm-n-g{font-family:var(--hm-font-mono,ui-monospace,SFMono-Regular,Menlo,Consolas,monospace);}}
ff+preset	.hm-n-g.hm-n-g{font-family:var(--hm-font,inherit);}@media (max-width:1024px){.hm-n-g.hm-n-g{font-family:var(--hm-font-heading,var(--hm-font,inherit));}}@media (max-width:640px){.hm-n-g.hm-n-g{font-family:var(--hm-font-mono,ui-monospace,SFMono-Regular,Menlo,Consolas,monospace);}}
fw	base=700 md=400 sm=bold
fw	.hm-n-g{font-weight:700;}@media (max-width:1024px){.hm-n-g{font-weight:400;}}@media (max-width:640px){.hm-n-g{font-weight:bold;}}
fw+preset	.hm-n-g.hm-n-g{font-weight:700;}@media (max-width:1024px){.hm-n-g.hm-n-g{font-weight:400;}}@media (max-width:640px){.hm-n-g.hm-n-g{font-weight:bold;}}
lh	base=normal md=1.4 sm=tight
lh	.hm-n-g{line-height:1.5;}@media (max-width:1024px){.hm-n-g{line-height:1.4;}}@media (max-width:640px){.hm-n-g{line-height:1.1;}}
lh+preset	.hm-n-g.hm-n-g{line-height:1.5;}@media (max-width:1024px){.hm-n-g.hm-n-g{line-height:1.4;}}@media (max-width:640px){.hm-n-g.hm-n-g{line-height:1.1;}}
ls	base=normal md=0.05em sm=-1px
ls	.hm-n-g{letter-spacing:normal;}@media (max-width:1024px){.hm-n-g{letter-spacing:0.05em;}}@media (max-width:640px){.hm-n-g{letter-spacing:-1px;}}
ls+preset	.hm-n-g.hm-n-g{letter-spacing:normal;}@media (max-width:1024px){.hm-n-g.hm-n-g{letter-spacing:0.05em;}}@media (max-width:640px){.hm-n-g.hm-n-g{letter-spacing:-1px;}}
tt	base=uppercase md=none sm=lowercase
tt	.hm-n-g{text-transform:uppercase;}@media (max-width:1024px){.hm-n-g{text-transform:none;}}@media (max-width:640px){.hm-n-g{text-transform:lowercase;}}
tt+preset	.hm-n-g.hm-n-g{text-transform:uppercase;}@media (max-width:1024px){.hm-n-g.hm-n-g{text-transform:none;}}@media (max-width:640px){.hm-n-g.hm-n-g{text-transform:lowercase;}}
td	base=underline md=none sm=line-through
td	.hm-n-g{text-decoration:underline;}@media (max-width:1024px){.hm-n-g{text-decoration:none;}}@media (max-width:640px){.hm-n-g{text-decoration:line-through;}}
td+preset	.hm-n-g.hm-n-g{text-decoration:underline;}@media (max-width:1024px){.hm-n-g.hm-n-g{text-decoration:none;}}@media (max-width:640px){.hm-n-g.hm-n-g{text-decoration:line-through;}}
fst	base=italic md=normal sm=italic
fst	.hm-n-g{font-style:italic;}@media (max-width:1024px){.hm-n-g{font-style:normal;}}@media (max-width:640px){.hm-n-g{font-style:italic;}}
fst+preset	.hm-n-g.hm-n-g{font-style:italic;}@media (max-width:1024px){.hm-n-g.hm-n-g{font-style:normal;}}@media (max-width:640px){.hm-n-g.hm-n-g{font-style:italic;}}
