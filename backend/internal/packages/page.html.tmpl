<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<title>{{.Title}}</title>
<style>
:root{--bg:#fff;--ink:#141417;--soft:#66666c;--label:#8a8a8a;--line:#e6e6e6}
@media (prefers-color-scheme:dark){:root{--bg:#0e0e10;--ink:#f2f2f3;--soft:#a1a1a8;--label:#8a8a8a;--line:#2a2a2e}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Geist,-apple-system,"Segoe UI",sans-serif}
.wrap{max-width:1200px;margin:0 auto;padding:64px 24px}
.label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--label)}
h1{font-size:40px;line-height:1.1;margin:8px 0 12px;font-weight:600}
.intro{color:var(--soft);max-width:560px;margin:0 0 24px}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px}
.btn{display:inline-block;padding:8px 16px;border:1px solid var(--line);border-radius:999px;color:var(--ink);text-decoration:none}
.btn:hover{border-color:var(--ink)}
#q{width:100%;padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:transparent;color:var(--ink);font:inherit;margin-bottom:24px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.card{border:1px solid var(--line);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:8px}
.card[hidden]{display:none}
.card h2{font-size:18px;margin:0}
.mono{font-family:"Geist Mono",ui-monospace,Menlo,monospace;font-size:13px;color:var(--soft)}
.meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--soft)}
.badge{border:1px solid var(--line);border-radius:999px;padding:1px 8px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--label)}
.desc{margin:0;color:var(--soft)}
.needs{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--soft)}
.warn{font-size:14px;color:var(--ink)}
.lines{font-size:13px;color:var(--soft)}
.lines summary{cursor:pointer;color:var(--label)}
.vh{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.lines ul{margin:6px 0 0;padding-left:18px}
.card a{color:var(--ink)}
.hint{margin-top:32px;color:var(--soft)}
</style>
</head>
<body>
<div class="wrap">
<div class="label">{{.Title}}</div>
<h1>{{.Title}}</h1>
<p class="intro">{{.Intro}}</p>
{{if or .WriteURL .SubmitURL}}<div class="actions">
{{if .WriteURL}}<a class="btn" href="{{.WriteURL}}">Write a plugin</a>{{end}}
{{if .SubmitURL}}<a class="btn" href="{{.SubmitURL}}">Submit a plugin</a>{{end}}
</div>{{end}}
<input id="q" type="search" placeholder="Search plugins" aria-label="Search plugins" autocomplete="off">
<div class="grid">
{{range .Cards}}<article class="card" data-search="{{.Search}}">
<h2>{{.Heading}}</h2>
<div class="meta"><span class="mono">{{.Name}} {{.Version}}</span>{{if .TierLabel}}<span class="badge">{{.TierLabel}}</span>{{end}}{{if .Author}}<span>by @{{.Author}}</span>{{end}}</div>
{{if .Description}}<p class="desc">{{.Description}}</p>{{end}}
{{if .PermCount}}<div class="needs"><span>{{.PermCount}} permission{{if ne .PermCount 1}}s{{end}}</span>{{if .PermWarn}}<span class="warn"><span aria-hidden="true">⚠</span><span class="vh">Warning: {{range $i, $w := .PermWarn}}{{if $i}} {{end}}{{$w}}{{end}}</span></span>{{end}}</div>
<details class="lines"><summary>Show permissions<span class="vh"> for {{.Heading}}</span></summary><ul>{{range .PermLines}}<li>{{if .Warn}}⚠ {{end}}<span class="mono">{{.Name}}</span> {{.Text}}</li>{{end}}</ul></details>{{else}}<div class="needs">No permissions</div>{{end}}
{{if .Source}}<a href="{{.Source}}" rel="noopener noreferrer">Source &rarr;</a>{{end}}
</article>
{{end}}</div>
{{if .InstallHint}}<p class="hint">{{.InstallHint}}</p>{{end}}
</div>
<script>
(function () {
  var q = document.getElementById("q");
  var cards = document.querySelectorAll("[data-search]");
  q.addEventListener("input", function () {
    var term = q.value.trim().toLowerCase();
    cards.forEach(function (c) {
      c.hidden = term !== "" && c.getAttribute("data-search").indexOf(term) < 0;
    });
  });
})();
</script>
</body>
</html>
