# Static site published by Hatamoto: /srv/site/public is served from disk.
# Island paths, the admin and previews are passed to Hatamoto on 127.0.0.1:8090.
example.com {
	@hatamoto_preview_query query hm_theme_preview=*
	handle @hatamoto_preview_query {
		reverse_proxy 127.0.0.1:8090
	}
	@hatamoto_preview_cookie header_regexp Cookie (^|;\s*)hm_theme_preview=
	handle @hatamoto_preview_cookie {
		reverse_proxy 127.0.0.1:8090
	}
	@hatamoto path /-/* /.well-known/* /admin /admin/* /api-public /api-public/* /api/* /auth/* /f/* /forms/* /mcp /mcp/* /p/* /plugin-ui/* /preview/* /search /theme/assets/hm-live.js
	handle @hatamoto {
		reverse_proxy 127.0.0.1:8090
	}
	@hatamoto_fallback path /fonts/* /media/* /theme/*
	handle @hatamoto_fallback {
		root * /srv/site/public
		@missing not file
		reverse_proxy @missing 127.0.0.1:8090
		file_server
	}
	@hatamoto_locale1 path_regexp ^/[^/]+/search$
	handle @hatamoto_locale1 {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		root * /srv/site/public
		@hidden path /_redirects /.hatamoto-static.json
		respond @hidden 404
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; form-action 'self'"
		}
		redir /old-page /new-page 301
		redir /promo https://example.com/offers?src=old 302
		@r1 path_regexp r1 ^/blog/([^/[:cntrl:]]+)/amp$
		redir @r1 /articles/{re.r1.1} 301
		@r2 path_regexp r2 ^/docs/([^[:cntrl:]]*)$
		redir @r2 /help/{re.r2.1} 308
		# skipped: /gone /elsewhere 410
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		root * /srv/site/public
		rewrite * /404.html
		file_server
	}
}
