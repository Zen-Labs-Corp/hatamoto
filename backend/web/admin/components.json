{
  "button": {
    "selector": ".hm-btn",
    "owner": "css/partials/button.css",
    "partial": "hm/button",
    "variants": {
      "sm": ".hm-btn--sm",
      "primary": ".hm-btn--primary",
      "ghost": ".hm-btn--ghost",
      "danger": ".hm-btn--danger",
      "icon": ".hm-btn--icon, .hm-btn[data-icon-only]",
      "pressed": ".hm-btn[aria-pressed=\"true\"]"
    },
    "props": {
      "border-top-left-radius": "var(--radius-sm)",
      "border-top-width": "0",
      "box-shadow": "inset 0 0 0 1px var(--segment-ring), inset 0 -2px 0 var(--segment-bevel)",
      "font-size": "var(--text-sm)",
      "font-weight": "var(--weight-medium)",
      "padding-left": "calc(var(--space-3) + var(--space-px))",
      "padding-right": "calc(var(--space-3) + var(--space-px))"
    },
    "variantProps": {
      "sm": {
        "padding-left": "calc(var(--space-2) + var(--space-px))",
        "padding-right": "calc(var(--space-2) + var(--space-px))"
      },
      "primary": {
        "box-shadow": "inset 0 -1px 0 var(--btn-edge-primary)"
      },
      "ghost": {
        "box-shadow": "none"
      },
      "danger": {
        "box-shadow": "inset 0 -1px 0 var(--btn-edge-danger)"
      },
      "icon": {
        "padding-left": "0",
        "padding-right": "0"
      },
      "pressed": {
        "box-shadow": "inset 0 0 0 1px var(--color-sumi)"
      }
    }
  },
  "input": {
    "selector": ".hm-field__control",
    "owner": "css/partials/field.css",
    "partial": "hm/field",
    "variants": {
      "select": "select.hm-field__control"
    },
    "props": {
      "border-top-color": "var(--border-field)",
      "border-top-left-radius": "var(--radius-sm)",
      "font-size": "var(--text-md)",
      "padding-left": "var(--space-3)",
      "padding-right": "var(--space-3)"
    },
    "variantProps": {
      "select": {
        "padding-right": "var(--space-8)"
      }
    }
  },
  "card": {
    "selector": ".hm-card",
    "owner": "css/partials/card.css",
    "props": {
      "border-top-color": "var(--color-kinu)",
      "border-top-left-radius": "var(--radius-lg)"
    }
  },
  "badge": {
    "selector": ".hm-badge",
    "owner": "css/partials/badge.css",
    "partial": "hm/badge",
    "props": {
      "border-top-left-radius": "var(--radius-full)",
      "font-size": "var(--text-xs)",
      "font-weight": "var(--weight-medium)",
      "height": "var(--badge-h)",
      "padding-left": "var(--space-2)",
      "padding-right": "var(--space-2)"
    }
  },
  "menu": {
    "selector": ".hm-menu",
    "owner": "css/partials/menu.css",
    "props": {
      "border-top-color": "var(--color-kinu)",
      "border-top-left-radius": "var(--radius-md)",
      "box-shadow": "var(--shadow-3)"
    }
  },
  "popover": {
    "selector": ".hm-popover-panel",
    "owner": "css/partials/popover.css",
    "props": {
      "border-top-color": "var(--color-kinu)",
      "border-top-left-radius": "var(--radius-md)",
      "box-shadow": "var(--shadow-3)"
    }
  },
  "select-list": {
    "selector": ".hm-select__list",
    "owner": "css/partials/select.css",
    "partial": "hm/select",
    "props": {
      "border-top-color": "var(--border-control)",
      "border-top-left-radius": "var(--radius-md)",
      "box-shadow": "var(--shadow-2)",
      "z-index": "var(--z-popup)"
    }
  },
  "searchselect-list": {
    "selector": ".hm-searchselect__list",
    "owner": "css/partials/searchselect.css",
    "partial": "hm/searchselect",
    "props": {
      "border-top-color": "var(--color-kinu)",
      "border-top-left-radius": "var(--radius-md)",
      "box-shadow": "var(--shadow-2)",
      "z-index": "var(--z-popup)"
    }
  },
  "dialog": {
    "selector": ".hm-dialog",
    "owner": "css/partials/dialog.css",
    "variants": {
      "drawer": ".hm-dialog[data-side=\"end\"]"
    },
    "props": {
      "border-top-color": "var(--color-kinu)",
      "border-top-left-radius": "var(--radius-lg)",
      "box-shadow": "var(--shadow-3)"
    },
    "variantProps": {
      "drawer": {
        "border-top-left-radius": "0"
      }
    }
  },
  "tabs": {
    "selector": ".hm-tabs__tab, .hm-tablist__tab",
    "owner": "css/partials/tabs.css",
    "partial": "hm/tabs",
    "variants": {
      "segmented": ".hm-tabs[data-variant=\"segmented\"] .hm-tabs__tab",
      "segmented-current": ".hm-tabs[data-variant=\"segmented\"] .hm-tabs__tab[aria-current=\"page\"]",
      "sub": ".hm-tabs[data-variant=\"sub\"] .hm-tabs__tab",
      "tablist": ".hm-tablist__tab"
    },
    "props": {
      "font-size": "var(--text-sm)",
      "font-weight": "var(--weight-medium)",
      "padding-left": "var(--space-2)",
      "padding-right": "var(--space-2)"
    },
    "variantProps": {
      "segmented": {
        "padding-left": "var(--space-3)",
        "padding-right": "var(--space-3)"
      },
      "segmented-current": {
        "background-color": "var(--color-paper)",
        "color": "var(--color-sumi)",
        "font-weight": "var(--weight-semibold)",
        "box-shadow": "0 0 0 1px var(--segment-ring), inset 0 -1px 0 var(--segment-bevel)"
      },
      "sub": {
        "font-size": "var(--text-xs)"
      }
    }
  },
  "chip": {
    "selector": ".hm-msel__chip, .hm-msel__more, .hm-filter-chip",
    "owner": "css/partials/multiselect.css",
    "props": {
      "border-top-left-radius": "var(--radius-full)",
      "font-size": "var(--text-xs)",
      "font-weight": "var(--weight-medium)",
      "height": "var(--chip-h)",
      "padding-left": "var(--space-2)",
      "padding-right": "var(--space-2)"
    }
  },
  "colophon": {
    "selector": ".hm-colophon",
    "owner": "css/partials/colophon.css",
    "props": {}
  },
  "dropzone": {
    "selector": ".hm-dropzone",
    "owner": "css/partials/dropzone.css",
    "partial": "hm/dropzone",
    "props": {
      "border-top-left-radius": "var(--radius-md)",
      "font-size": "var(--text-sm)",
      "padding-left": "var(--space-4)",
      "padding-right": "var(--space-4)"
    }
  },
  "savestate": {
    "selector": ".hm-savestate",
    "owner": "css/partials/savestate.css",
    "partial": "hm/savestate",
    "props": {
      "border-top-left-radius": "var(--radius-md)",
      "font-size": "var(--text-sm)",
      "padding-left": "var(--space-3)",
      "padding-right": "var(--space-3)"
    }
  },
  "confirmcard": {
    "selector": ".hm-confirmcard",
    "owner": "css/partials/confirmcard.css",
    "partial": "hm/confirmcard",
    "props": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "var(--space-4)"
    }
  },
  "swatches": {
    "selector": ".hm-swatches__opt",
    "owner": "css/partials/swatches.css",
    "partial": "hm/swatches",
    "props": {
      "border-top-left-radius": "var(--radius-sm)",
      "font-size": "var(--text-sm)",
      "font-weight": "var(--weight-medium)",
      "padding-left": "var(--space-2)"
    }
  },
  "segmented": {
    "selector": ".hm-segmented__btn",
    "owner": "css/partials/segmented.css",
    "partial": "hm/segmented",
    "variants": {
      "pressed": ".hm-segmented__btn[aria-pressed=\"true\"]",
      "checked": ".hm-segmented__input:checked + .hm-segmented__btn"
    },
    "props": {
      "border-top-left-radius": "var(--radius-sm)",
      "font-size": "var(--text-sm)",
      "font-weight": "var(--weight-medium)",
      "padding-left": "var(--space-3)",
      "padding-right": "var(--space-3)"
    },
    "variantProps": {
      "pressed": {
        "background-color": "var(--color-paper)",
        "color": "var(--color-sumi)",
        "font-weight": "var(--weight-semibold)",
        "box-shadow": "0 0 0 1px var(--segment-ring), inset 0 -1px 0 var(--segment-bevel)"
      },
      "checked": {
        "background-color": "var(--color-paper)",
        "color": "var(--color-sumi)",
        "font-weight": "var(--weight-semibold)",
        "box-shadow": "0 0 0 1px var(--segment-ring), inset 0 -1px 0 var(--segment-bevel)"
      }
    }
  },
  "radiocard": {
    "selector": ".hm-radiocard",
    "owner": "css/partials/radiocard.css",
    "partial": "hm/radiocard",
    "props": {
      "border-top-left-radius": "var(--radius-md)",
      "font-size": "var(--text-sm)",
      "padding-left": "var(--space-4)",
      "padding-right": "var(--space-4)"
    }
  },
  "danger-confirm": {
    "selector": ".hm-danger-confirm",
    "owner": "css/partials/danger-confirm.css",
    "partial": "hm/danger-confirm",
    "props": {
      "border-top-left-radius": "0",
      "font-size": "var(--text-sm)",
      "padding-left": "0",
      "padding-right": "0"
    }
  },
  "switch": {
    "selector": ".hm-switch .hm-field__box",
    "owner": "css/partials/field.css",
    "partial": "hm/field",
    "props": {}
  },
  "savebar": {
    "selector": ".hm-savebar",
    "owner": "css/partials/savebar.css",
    "props": {}
  },
  "table": {
    "selector": ".hm-table",
    "owner": "css/partials/table.css",
    "partial": "hm/table",
    "props": {}
  },
  "statcard": {
    "selector": ".hm-statcard",
    "owner": "css/partials/chart.css",
    "partial": "hm/stat",
    "props": {}
  },
  "statgrid": {
    "selector": ".hm-statgrid",
    "owner": "css/partials/chart.css",
    "partial": "hm/stats",
    "props": {}
  }
}
