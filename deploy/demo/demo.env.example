# /etc/hatamoto-demo/demo.env - environment of hatamoto-demo.service (root:hatamoto-demo, chmod 640).
# Everything the public demo needs; nothing of the main site's config.

ENVIRONMENT=production
API_HOST=127.0.0.1
API_PORT=8091
PUBLIC_BASE_URL=https://demo.hatamoto.dev

# Its own Postgres cluster (port 5442, data dir on the size-capped filesystem), its own role
DATABASE_URL=postgresql://hatamoto_demo:CHANGE_ME@127.0.0.1:5442/hatamoto_demo?sslmode=disable
# Few connections: the demo's cluster allows 24 in all (postgresql.demo.conf).
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1

# Its own data dir (secrets, uploads, compile cache). reset.sh empties it every hour.
HATAMOTO_DATA=/var/lib/hatamoto-demo/data
MEDIA_UPLOAD_DIR=/var/lib/hatamoto-demo/data/uploads
MEDIA_MAX_SIZE_MB=2

# Disk guards (demo mode). The hard bound is the size-capped filesystem under /var/lib/hatamoto-demo,
# which holds the demo's own Postgres cluster too (docs/deploy/public-demo.md, step 2); these keep
# one visitor from using it all.
# Total size of all uploads and their variants; further uploads are refused:
HATAMOTO_DEMO_MEDIA_QUOTA_MB=200
# Bytes written per signed-in session and per client address (IPv6: per /64) until the next restart;
# the next write of a spent key answers 429, other visitors and sign-in are not affected:
HATAMOTO_DEMO_WRITE_BUDGET_MB=150
# Write requests (every non-GET) per second and address; the burst is 20:
HATAMOTO_DEMO_WRITES_PER_SECOND=2

# The demo mode (see docs: refuses uploads, unsigned and third-party installs, user, password and
# key changes, outbound settings and updates; shows the banner and the login below).
HATAMOTO_DEMO=1
HATAMOTO_DEMO_LOGIN_EMAIL=demo@demo.hatamoto.dev
HATAMOTO_DEMO_LOGIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

# Nothing leaves the box except the first-party registry that the admin browses on demand.
EMAIL_DISABLED=true
HATAMOTO_AGENT_RANGES=off
WORKER_DISABLE_JOBS=agent_ranges_refresh,agent_verify,update_check,webhook_deliver,webhook_prune
HATAMOTO_REGISTRY_URL=https://hatamoto.dev/registry.json

# Caddy is the only proxy and runs on this machine (loopback is the default trusted proxy).
# HATAMOTO_TRUSTED_PROXIES=
# Anyone can edit the content, so the browser enforces the CSP instead of only reporting it.
CSP_ENFORCE=true
