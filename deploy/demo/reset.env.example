# /etc/hatamoto-demo/reset.env - read by deploy/demo/reset.sh (root only: chmod 600, it holds a password).
# The reset refuses to run unless these agree with the demo service's own env file.

# The demo service's env file: reset.sh reads DATABASE_URL and HATAMOTO_DATA from it and
# compares them with DEMO_DB and DEMO_DATA_DIR below.
DEMO_APP_ENV=/etc/hatamoto-demo/demo.env

# The demo database (dropped and recreated every hour) and the template it is copied from.
DEMO_DB=hatamoto_demo
DEMO_TEMPLATE_DB=hatamoto_demo_template
# The role that owns both (the demo service's database login).
DEMO_OWNER_ROLE=hatamoto_demo

# The demo data dir (emptied every hour; must hold the file .hatamoto-demo) and the
# seeded copy it is filled from. Both live under /var/lib/hatamoto-demo.
DEMO_DATA_DIR=/var/lib/hatamoto-demo/data
DEMO_DATA_TEMPLATE=/var/lib/hatamoto-demo/template-data

# The demo's OWN Postgres cluster: its data dir (on the size-capped filesystem, beside DEMO_DATA_DIR)
# and port. reset.sh refuses to run unless the cluster it connects to reports exactly these (and the
# cluster_name hatamoto-demo), and the demo service's DATABASE_URL uses the same port.
DEMO_PG_DATA=/var/lib/hatamoto-demo/pg
DEMO_PG_PORT=5442

# Connection of the reset role (CREATEDB only, no superuser, no CREATEROLE) to the "postgres" database.
# No password in the URL (it would show in the process list): it is read from DEMO_PGPASSFILE,
# a root-only (mode 600) file with the line  127.0.0.1:5442:*:hatamoto_demo_reset:<password>
DEMO_ADMIN_URL=postgresql://hatamoto_demo_reset@127.0.0.1:5442/postgres?sslmode=disable
DEMO_PGPASSFILE=/etc/hatamoto-demo/pgpass

DEMO_UNIT=hatamoto-demo.service
DEMO_USER=hatamoto-demo
DEMO_HEALTH_URL=http://127.0.0.1:8091/health

# Space-recovery ballast: a file on the capped filesystem that every reset deletes FIRST (with the uploads,
# before any Postgres step) and recreates at the end, so a filesystem the visitors filled has room for the
# reset. It must be directly in DEMO_DATA_ROOT and named .ballast*. The runbook creates the first one.
DEMO_BALLAST=/var/lib/hatamoto-demo/.ballast
DEMO_BALLAST_MB=64
DEMO_PG_UNIT=hatamoto-demo-pg.service
