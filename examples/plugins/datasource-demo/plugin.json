{
  "name": "datasource-demo",
  "version": "0.1.0",
  "sdk": "^0.11",
  "description": "Reference builder data source: a text value, a URL value and an item list.",
  "permissions": ["builder.data"],
  "builder_sources": [
    { "name": "temp", "label": "Temperature", "kind": "value", "class": "text" },
    { "name": "forecast", "label": "Forecast", "kind": "items" },
    { "name": "link", "label": "Docs link", "kind": "value", "class": "url" }
  ],
  "config": { "mode": "ok", "temp": "21°C" },
  "limits": { "memory_pages": 256, "hook_timeouts_ms": { "builder.data": 300 }, "max_instances": 4 }
}
