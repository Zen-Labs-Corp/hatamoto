{
  "name": "frameplug",
  "version": "0.1.0",
  "sdk": "^0.22.2",
  "description": "QA fixture: a plugin with an admin page and an import run and a cron started run with a standing approval rule, for the browser scripts. Use it through run-local.sh, which builds its plugin.wasm.",
  "permissions": ["mail.send"],
  "allowed_hosts": ["example.com"],
  "runs": [
    {
      "name": "import",
      "title": "Import",
      "inputs": [
        { "name": "source", "label": "Source address", "type": "url", "required": true },
        { "name": "limit", "label": "How many pages", "type": "number" }
      ],
      "stages": ["fetch", "transform"],
      "proposes": ["site_settings", "url_patterns"]
    },
    {
      "name": "refresh",
      "title": "Refresh view counts",
      "stages": ["fetch", "transform"],
      "cron": "refresh_daily",
      "standing_approval": { "fields": ["views", "rating"], "schemas": ["post"], "max_per_hour": 100 }
    }
  ],
  "cron": [{ "name": "refresh_daily", "every": "24h" }],
  "ui": { "title": "Frames", "entry": "index.html", "roles": ["owner", "editor"], "allow": ["camera"] }
}
